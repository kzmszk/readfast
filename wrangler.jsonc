{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "readfast",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "send_metrics": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": false }
}
