{
  "name": "readfast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 server.py",
    "test": "node --test && python3 -m unittest discover -s test -p '*_test.py'",
    "build:segmenter": "node scripts/build-segmenter.mjs",
    "build:worker": "python3 scripts/build-worker-catalog.py",
    "dev:worker": "npm run build:worker && wrangler dev --port 8797 --inspector-port 9297 --ip 127.0.0.1",
    "deploy": "npm run build:worker && wrangler deploy"
  },
  "devDependencies": {
    "budoux": "0.9.2",
    "esbuild": "0.28.2",
    "wrangler": "4.142.0"
  },
  "dependencies": {
    "htmlparser2": "12.0.0"
  }
}
